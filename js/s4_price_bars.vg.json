{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A Special illustration rare sells for about 230 times a Common",
    "subtitle": "Median price in US dollars, cards from 2023 to 2026 sets (October 2026)",
    "anchor": "start"
  },
  "width": 520,
  "height": 260,
  "data": {
    "url": "data/prices_modern_by_tier.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "median",
          "field": "market_usd",
          "as": "median_price"
        },
        {
          "op": "count",
          "as": "cards"
        }
      ],
      "groupby": [
        "tier",
        "tier_no"
      ]
    },
    {
      "calculate": "replace(datum.tier, '-', ' ')",
      "as": "rarity"
    }
  ],
  "encoding": {
    "y": {
      "field": "rarity",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "tier_no",
        "op": "min"
      }
    },
    "x": {
      "field": "median_price",
      "type": "quantitative",
      "title": "Typical price (US$)",
      "axis": {
        "format": "$,.0f",
        "tickCount": 6
      }
    }
  },
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.tier_no >= 4",
            "value": "#6a51a3"
          },
          "value": "#969696"
        },
        "tooltip": [
          {
            "field": "rarity",
            "title": "Rarity"
          },
          {
            "field": "median_price",
            "type": "quantitative",
            "title": "Typical price (US$)",
            "format": "$,.2f"
          },
          {
            "field": "cards",
            "type": "quantitative",
            "title": "Cards checked"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "median_price",
          "type": "quantitative",
          "format": "$,.2f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans, sans-serif",
    "title": {
      "font": "Fredoka, Nunito Sans, sans-serif",
      "fontSize": 19,
      "fontWeight": 600,
      "color": "#222",
      "subtitleFont": "Nunito Sans, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5d6573",
      "anchor": "start",
      "offset": 10
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444",
      "titleColor": "#444"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444"
    },
    "header": {
      "labelFontSize": 14,
      "labelFont": "Nunito Sans, sans-serif"
    },
    "text": {
      "fontSize": 12
    }
  }
}
