{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "Measure_selection == 'players' ? 'Japan and the US send the most players to Worlds' : 'Per person, Australia sends about twice as many players to Worlds as the US'"
    },
    "subtitle": [
      "Pick the year and measure under the map. Click a bar to highlight that country."
    ],
    "anchor": "start"
  },
  "params": [
    {
      "name": "Season_selection",
      "value": 2026,
      "bind": {
        "input": "radio",
        "options": [
          2025,
          2026
        ],
        "labels": [
          "Worlds 2025 (Anaheim)",
          "Worlds 2026 (San Francisco)"
        ],
        "name": "Championship: "
      }
    },
    {
      "name": "Measure_selection",
      "value": "per_million",
      "bind": {
        "input": "radio",
        "options": [
          "per_million",
          "players"
        ],
        "labels": [
          "Per million people",
          "Total players"
        ],
        "name": "Show: "
      }
    }
  ],
  "hconcat": [
    {
      "width": 560,
      "height": 330,
      "projection": {
        "type": "equalEarth"
      },
      "layer": [
        {
          "data": {
            "url": "js/ne_110m_admin_0_countries.topojson",
            "format": {
              "type": "topojson",
              "feature": "ne_110m_admin_0_countries"
            }
          },
          "transform": [
            {
              "filter": "datum.properties.ADM0_A3 != 'ATA'"
            },
            {
              "calculate": "'No players from ' + datum.properties.NAME",
              "as": "note"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": "#e5e5e5",
            "stroke": "white",
            "strokeWidth": 0.5
          },
          "encoding": {
            "tooltip": {
              "field": "note"
            }
          }
        },
        {
          "data": {
            "url": "data/worlds_players.csv",
            "format": {
              "parse": {
                "players": "number",
                "per_million": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.season == Season_selection"
            },
            {
              "lookup": "iso3",
              "from": {
                "data": {
                  "url": "js/ne_110m_admin_0_countries.topojson",
                  "format": {
                    "type": "topojson",
                    "feature": "ne_110m_admin_0_countries"
                  }
                },
                "key": "properties.ADM0_A3"
              },
              "as": "geo"
            },
            {
              "filter": "isValid(datum.geo)"
            },
            {
              "calculate": "Measure_selection == 'players' ? datum.players : datum.per_million",
              "as": "value"
            }
          ],
          "mark": {
            "type": "geoshape",
            "stroke": "white",
            "strokeWidth": 0.5
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            },
            "color": {
              "field": "value",
              "type": "quantitative",
              "title": "Darker = more players",
              "scale": {
                "type": "threshold",
                "domain": {
                  "expr": "Measure_selection == 'players' ? [3, 10, 25, 50, 100] : [0.1, 0.25, 0.5, 1, 2]"
                },
                "range": [
                  "#c6dbef",
                  "#9ecae1",
                  "#6baed6",
                  "#4292c6",
                  "#2171b5",
                  "#08306b"
                ]
              },
              "legend": {
                "orient": "bottom",
                "direction": "horizontal",
                "gradientLength": 200,
                "title": "Darker = more players"
              }
            },
            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "players",
                "type": "quantitative",
                "title": "Players at Worlds"
              },
              {
                "field": "per_million",
                "type": "quantitative",
                "title": "Per million people",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/worlds_players.csv",
            "format": {
              "parse": {
                "players": "number",
                "per_million": "number"
              }
            }
          },
          "transform": [
            {
              "filter": "datum.season == Season_selection"
            },
            {
              "filter": {
                "param": "Country_pick",
                "empty": false
              }
            },
            {
              "lookup": "iso3",
              "from": {
                "data": {
                  "url": "js/ne_110m_admin_0_countries.topojson",
                  "format": {
                    "type": "topojson",
                    "feature": "ne_110m_admin_0_countries"
                  }
                },
                "key": "properties.ADM0_A3"
              },
              "as": "geo"
            },
            {
              "filter": "isValid(datum.geo)"
            }
          ],
          "mark": {
            "type": "geoshape",
            "fill": null,
            "stroke": "#d9342b",
            "strokeWidth": 2
          },
          "encoding": {
            "shape": {
              "field": "geo",
              "type": "geojson"
            }
          }
        }
      ]
    },
    {
      "width": 200,
      "height": 330,
      "title": {
        "text": "Top 15 countries",
        "fontSize": 12
      },
      "data": {
        "url": "data/worlds_players.csv",
        "format": {
          "parse": {
            "players": "number",
            "per_million": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.season == Season_selection"
        },
        {
          "filter": "datum.players >= 3"
        },
        {
          "calculate": "Measure_selection == 'players' ? datum.players : datum.per_million",
          "as": "value"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "value",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rank <= 15"
        },
        {
          "calculate": "Measure_selection == 'players' ? format(datum.value, 'd') : format(datum.value, '.2f')",
          "as": "label"
        }
      ],
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {
            "field": "value",
            "op": "max",
            "order": "descending"
          },
          "title": null
        },
        "x": {
          "field": "value",
          "type": "quantitative",
          "title": null,
          "axis": null
        }
      },
      "layer": [
        {
          "params": [
            {
              "name": "Country_pick",
              "value": [
                {
                  "iso3": "AUS"
                }
              ],
              "select": {
                "type": "point",
                "fields": [
                  "iso3"
                ]
              }
            }
          ],
          "mark": {
            "type": "bar",
            "cursor": "pointer"
          },
          "encoding": {
            "color": {
              "condition": {
                "param": "Country_pick",
                "value": "#d9342b",
                "empty": false
              },
              "value": "#6baed6"
            },
            "tooltip": [
              {
                "field": "country",
                "type": "nominal",
                "title": "Country"
              },
              {
                "field": "players",
                "type": "quantitative",
                "title": "Players at Worlds"
              },
              {
                "field": "per_million",
                "type": "quantitative",
                "title": "Per million people",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 3,
            "fontSize": 11
          },
          "encoding": {
            "text": {
              "field": "label"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans, sans-serif",
    "title": {
      "font": "Fredoka, Nunito Sans, sans-serif",
      "fontSize": 19,
      "fontWeight": 600,
      "color": "#222",
      "subtitleFont": "Nunito Sans, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5d6573",
      "anchor": "start",
      "offset": 10
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444",
      "titleColor": "#444"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444"
    },
    "header": {
      "labelFontSize": 14,
      "labelFont": "Nunito Sans, sans-serif"
    },
    "text": {
      "fontSize": 12
    }
  }
}
