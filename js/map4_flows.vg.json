{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where the players at Worlds 2026 came from",
    "subtitle": "Each line goes from a country to San Francisco. Thicker line = more players. Australia is in red.",
    "anchor": "start"
  },
  "width": 820,
  "height": 400,
  "projection": {"type": "equalEarth", "rotate": [100, 0, 0]},
  "layer": [
    {
      "data": {
        "url": "js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [{"filter": "datum.properties.ADM0_A3 != 'ATA'"}],
      "mark": {"type": "geoshape", "fill": "#e5e5e5", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/worlds_flows.csv"},
      "transform": [
        {"filter": "datum.season == 2026"},
        {"calculate": "datum.iso2 == 'AU' ? 'Australia' : 'Other countries'", "as": "group"}
      ],
      "layer": [
        {
          "mark": {"type": "rule", "strokeCap": "round"},
          "encoding": {
            "longitude": {"field": "src_lon", "type": "quantitative"},
            "latitude": {"field": "src_lat", "type": "quantitative"},
            "longitude2": {"field": "dst_lon"},
            "latitude2": {"field": "dst_lat"},
            "strokeWidth": {
              "field": "players",
              "type": "quantitative",
              "title": "Players",
              "scale": {"range": [0.5, 10]},
              "legend": {"values": [5, 50, 140], "orient": "bottom-left"}
            },
            "color": {
              "field": "group",
              "type": "nominal",
              "scale": {"domain": ["Australia", "Other countries"], "range": ["#d62728", "#3182bd"]},
              "legend": null
            },
            "order": {"field": "group", "sort": "descending"},
            "tooltip": [
              {"field": "country", "title": "Country"},
              {"field": "players", "type": "quantitative", "title": "Players"}
            ],
            "opacity": {"condition": {"test": "datum.iso2 == 'AU'", "value": 1}, "value": 0.55}
          }
        },
        {
          "transform": [{"filter": "datum.players >= 30 || datum.iso2 == 'AU'"}],
          "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "dy": 12},
          "encoding": {
            "longitude": {"field": "src_lon", "type": "quantitative"},
            "latitude": {"field": "src_lat", "type": "quantitative"},
            "text": {"field": "country"},
            "color": {"field": "group", "type": "nominal", "legend": null}
          }
        }
      ]
    },
    {
      "data": {"values": [{"lon": -122.4, "lat": 37.8, "name": "San Francisco"}]},
      "layer": [
        {
          "mark": {"type": "point", "shape": "diamond", "size": 150, "filled": true, "color": "black"},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"}
          }
        },
        {
          "mark": {"type": "text", "align": "right", "dx": -10, "fontSize": 11, "fontWeight": "bold"},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "name"}
          }
        }
      ]
    }
  ],
  "config": {"view": {"stroke": null}}
}
