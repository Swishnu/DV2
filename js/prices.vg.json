{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A Special illustration rare typically sells for about 230 times a Common",
    "subtitle": "Market prices as of 2 October 2026 (US$)"
  },
  "width": "container",
  "height": 380,
  "data": {
    "url": "data/prices.csv",
    "format": {
      "parse": {
        "market_usd": "number",
        "tier_no": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "replace(datum.tier, '-', ' ')",
      "as": "rarity"
    },
    {
      "calculate": "datum.tier_no >= 4 ? 'Special rare' : 'Normal'",
      "as": "group"
    }
  ],
  "encoding": {
    "y": {
      "field": "rarity",
      "type": "nominal",
      "title": null,
      "sort": [
        "Common",
        "Uncommon",
        "Rare",
        "Powered up rare",
        "Ultra rare (full art)",
        "Shiny rare",
        "Illustration rare",
        "Special illustration rare",
        "Secret / hyper rare"
      ],
      "axis": {
        "labelFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": 1.5,
        "size": 26,
        "outliers": false,
        "median": {
          "color": "white",
          "strokeWidth": 2.5
        },
        "rule": {
          "color": "#aaa"
        },
        "ticks": false
      },
      "encoding": {
        "x": {
          "field": "market_usd",
          "type": "quantitative",
          "title": "Price (US$)",
          "scale": {
            "type": "log",
            "domain": [
              0.01,
              300
            ]
          },
          "axis": {
            "values": [
              0.01,
              0.1,
              1,
              10,
              100
            ],
            "labelExpr": "datum.value < 0.05 ? '1 cent' : datum.value < 1 ? '10 cents' : '$' + format(datum.value, ',')",
            "labelFontSize": 12,
            "grid": true,
            "title": null
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Normal",
              "Special rare"
            ],
            "range": [
              "#969696",
              "#6a51a3"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "market_usd",
              "as": "median_price"
            },
            {
              "op": "count",
              "as": "cards"
            },
            {
              "op": "q3",
              "field": "market_usd",
              "as": "q3"
            },
            {
              "op": "q1",
              "field": "market_usd",
              "as": "q1"
            },
            {
              "op": "max",
              "field": "market_usd",
              "as": "mx"
            }
          ],
          "groupby": [
            "rarity"
          ]
        },
        {
          "calculate": "min(datum.mx, datum.q3 + 1.5 * (datum.q3 - datum.q1))",
          "as": "whisker_end"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 13,
        "fontWeight": 800,
        "color": "#222"
      },
      "encoding": {
        "x": {
          "field": "whisker_end",
          "type": "quantitative"
        },
        "text": {
          "field": "median_price",
          "type": "quantitative",
          "format": "$,.2f"
        },
        "tooltip": [
          {
            "field": "rarity",
            "title": "Rarity"
          },
          {
            "field": "median_price",
            "type": "quantitative",
            "title": "Typical price",
            "format": "$,.2f"
          },
          {
            "field": "q1",
            "type": "quantitative",
            "title": "Cheapest quarter up to",
            "format": "$,.2f"
          },
          {
            "field": "q3",
            "type": "quantitative",
            "title": "Priciest quarter from",
            "format": "$,.2f"
          },
          {
            "field": "cards",
            "type": "quantitative",
            "title": "Cards"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans, sans-serif",
    "title": {
      "font": "Fredoka, Nunito Sans, sans-serif",
      "fontSize": 19,
      "fontWeight": 600,
      "color": "#222",
      "subtitleFont": "Nunito Sans, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5d6573",
      "anchor": "start",
      "offset": 10
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444",
      "titleColor": "#444"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444"
    },
    "header": {
      "labelFontSize": 14,
      "labelFont": "Nunito Sans, sans-serif"
    },
    "text": {
      "fontSize": 12
    }
  }
}
