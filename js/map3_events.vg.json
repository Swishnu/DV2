{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Official tournaments, September 2024 to September 2026",
    "subtitle": "Bigger dot = more players. Drag across the timeline under the map to show only those months.",
    "anchor": "start"
  },
  "data": {"url": "data/events_map.csv"},
  "transform": [
    {
      "calculate": "datum.tier == 'Special Event' ? 'Special event' : datum.tier == 'International' ? 'International championship' : datum.tier == 'Worlds' ? 'World Championships' : 'Regional championship'",
      "as": "event_type"
    }
  ],
  "vconcat": [
    {
      "width": 820,
      "height": 340,
      "projection": {"type": "equalEarth"},
      "layer": [
        {
          "data": {
            "url": "js/ne_110m_admin_0_countries.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
          },
          "transform": [{"filter": "datum.properties.ADM0_A3 != 'ATA'"}],
          "mark": {"type": "geoshape", "fill": "#e5e5e5", "stroke": "white", "strokeWidth": 0.5}
        },
        {
          "transform": [{"filter": {"param": "Date_brush"}}],
          "mark": {"type": "circle", "stroke": "white", "strokeWidth": 0.8, "opacity": 0.8},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "players",
              "type": "quantitative",
              "title": "Players",
              "scale": {"domain": [0, 4000], "range": [10, 500]},
              "legend": {"values": [500, 2000, 4000], "orient": "top", "direction": "horizontal"}
            },
            "color": {
              "field": "event_type",
              "type": "nominal",
              "title": "Event",
              "scale": {
                "domain": [
                  "Regional championship",
                  "Special event",
                  "International championship",
                  "World Championships"
                ],
                "range": ["#3182bd", "#9ecae1", "#e6550d", "#d62728"]
              },
              "legend": {"orient": "top", "direction": "horizontal"}
            },
            "tooltip": [
              {"field": "name", "title": "Event"},
              {"field": "date", "type": "temporal", "title": "Date", "format": "%d %b %Y"},
              {"field": "players", "type": "quantitative", "title": "Players", "format": ","}
            ]
          }
        },
        {
          "data": {
            "values": [
              {
                "lon": 118,
                "lat": -40,
                "t": ["7 events in Australia:", "Perth, Brisbane,", "Melbourne and Sydney"]
              }
            ]
          },
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 10,
            "fontStyle": "italic",
            "baseline": "top",
            "lineHeight": 12
          },
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "t"}
          }
        }
      ]
    },
    {
      "width": 820,
      "height": 70,
      "title": {"text": "Players per month (drag here)", "fontSize": 11, "anchor": "start"},
      "params": [{"name": "Date_brush", "select": {"type": "interval", "encodings": ["x"]}}],
      "mark": {"type": "bar", "color": "#969696"},
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "timeUnit": "yearmonth",
          "title": null,
          "axis": {"format": "%b %Y", "tickCount": 12}
        },
        "y": {
          "field": "players",
          "type": "quantitative",
          "aggregate": "sum",
          "title": null,
          "axis": {"tickCount": 2}
        }
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
