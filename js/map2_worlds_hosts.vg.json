{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "World Championship host cities",
    "subtitle": "Bigger circle = hosted more times",
    "anchor": "start"
  },
  "width": 430,
  "height": 240,
  "projection": {
    "type": "equalEarth",
    "scale": 80,
    "translate": [
      215,
      125
    ]
  },
  "layer": [
    {
      "data": {
        "url": "js/ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.ADM0_A3 != 'ATA'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e5e5e5",
        "stroke": "white",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/worlds_hosts.csv"
      },
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "times"
            }
          ],
          "groupby": [
            "city",
            "country",
            "lat",
            "lon",
            "status"
          ]
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "stroke": "white",
            "strokeWidth": 1
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "times",
              "type": "quantitative",
              "title": "Times hosted",
              "scale": {
                "domain": [
                  1,
                  3
                ],
                "range": [
                  60,
                  320
                ]
              },
              "legend": {
                "values": [
                  1,
                  2,
                  3
                ],
                "orient": "top",
                "direction": "horizontal",
                "format": "d"
              }
            },
            "color": {
              "field": "status",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "held",
                  "announced"
                ],
                "range": [
                  "#6baed6",
                  "#1e2c4f"
                ]
              },
              "legend": {
                "labelExpr": "datum.label == 'held' ? 'Held' : 'Announced (2027)'",
                "orient": "top",
                "direction": "horizontal"
              }
            },
            "opacity": {
              "value": 0.75
            },
            "tooltip": [
              {
                "field": "city",
                "title": "City"
              },
              {
                "field": "country",
                "title": "Country"
              },
              {
                "field": "times",
                "type": "quantitative",
                "title": "Times hosted"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.country != 'United States'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontSize": 11
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "city"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "lon": -95,
            "lat": 18,
            "text": [
              "18 of 21 in",
              "the USA"
            ]
          },
          {
            "lon": 135,
            "lat": -42,
            "text": [
              "Never in",
              "Australia"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontStyle": "italic",
        "lineHeight": 12,
        "baseline": "top"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans, sans-serif",
    "title": {
      "font": "Fredoka, Nunito Sans, sans-serif",
      "fontSize": 19,
      "fontWeight": 600,
      "color": "#222",
      "subtitleFont": "Nunito Sans, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5d6573",
      "anchor": "start",
      "offset": 10
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444",
      "titleColor": "#444"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444"
    },
    "header": {
      "labelFontSize": 14,
      "labelFont": "Nunito Sans, sans-serif"
    },
    "text": {
      "fontSize": 12
    }
  }
}
