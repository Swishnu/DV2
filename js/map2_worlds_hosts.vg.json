{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "World Championship host cities",
    "subtitle": "Bigger circle = hosted more times. No Worlds held in person in 2020 and 2021.",
    "anchor": "start"
  },
  "width": 400,
  "height": 210,
  "projection": {"type": "equalEarth", "scale": 72, "translate": [200, 110]},
  "layer": [
    {
      "data": {
        "url": "js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "transform": [{"filter": "datum.properties.ADM0_A3 != 'ATA'"}],
      "mark": {"type": "geoshape", "fill": "#e5e5e5", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/worlds_hosts.csv"},
      "transform": [
        {
          "aggregate": [{"op": "count", "as": "times"}],
          "groupby": ["city", "country", "lat", "lon", "status"]
        }
      ],
      "layer": [
        {
          "mark": {"type": "circle", "stroke": "white", "strokeWidth": 1},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "size": {
              "field": "times",
              "type": "quantitative",
              "title": "Times hosted",
              "scale": {"domain": [1, 4], "range": [60, 400]},
              "legend": {"values": [1, 2, 4], "orient": "bottom", "direction": "horizontal"}
            },
            "color": {
              "field": "status",
              "type": "nominal",
              "title": null,
              "scale": {"domain": ["held", "announced"], "range": ["#3182bd", "#e6550d"]},
              "legend": {
                "labelExpr": "datum.label == 'held' ? 'Held' : 'Announced (2027)'",
                "orient": "bottom",
                "direction": "horizontal"
              }
            },
            "opacity": {"value": 0.75},
            "tooltip": [
              {"field": "city", "title": "City"},
              {"field": "country", "title": "Country"},
              {"field": "times", "type": "quantitative", "title": "Times hosted"}
            ]
          }
        },
        {
          "transform": [{"filter": "datum.country != 'United States'"}],
          "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 10},
          "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "text": {"field": "city"}
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {"lon": -95, "lat": 18, "text": ["17 of 21 in", "the USA"]},
          {"lon": 135, "lat": -42, "text": ["Never in", "Australia"]}
        ]
      },
      "mark": {"type": "text", "fontSize": 10, "fontStyle": "italic", "lineHeight": 12, "baseline": "top"},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "text"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
