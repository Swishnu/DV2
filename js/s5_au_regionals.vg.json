{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Australian Regional Championships are growing",
    "subtitle": "Players at each event",
    "anchor": "start"
  },
  "width": 700,
  "height": 240,
  "data": {
    "url": "data/australian_events.csv"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%b %Y",
        "tickCount": 8
      },
      "scale": {
        "domain": [
          "2024-10-15",
          "2026-11-15"
        ]
      }
    },
    "y": {
      "field": "players",
      "type": "quantitative",
      "title": "Players",
      "scale": {
        "domain": [
          0,
          1100
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#3182bd",
        "point": {
          "size": 60,
          "color": "#3182bd"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontSize": 11
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.city + ' ' + datum.players",
      "as": "label"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Nunito Sans, sans-serif",
    "title": {
      "font": "Fredoka, Nunito Sans, sans-serif",
      "fontSize": 19,
      "fontWeight": 600,
      "color": "#222",
      "subtitleFont": "Nunito Sans, sans-serif",
      "subtitleFontSize": 13,
      "subtitleColor": "#5d6573",
      "anchor": "start",
      "offset": 10
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444",
      "titleColor": "#444"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 700,
      "labelColor": "#444"
    },
    "header": {
      "labelFontSize": 14,
      "labelFont": "Nunito Sans, sans-serif"
    },
    "text": {
      "fontSize": 12
    }
  }
}
