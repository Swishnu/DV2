{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Section 2: dumbbell chart of average set size in each era",
  "title": {
    "text": "Average cards per set in each era",
    "subtitle": "Grey dot = numbered cards. Orange dot = total including secret cards.",
    "anchor": "start"
  },
  "width": 560,
  "height": 300,
  "data": {"url": "data/eras.csv"},
  "transform": [
    {"calculate": "year(datum.start) + ' to ' + year(datum.end)", "as": "years"},
    {"calculate": "datum.era + ' (' + datum.years + ')'", "as": "era_label"},
    {"calculate": "datum.avg_total - datum.avg_official", "as": "secret"}
  ],
  "encoding": {
    "y": {
      "field": "era_label",
      "type": "nominal",
      "title": null,
      "sort": {"field": "era_order", "op": "min"}
    }
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#e6550d", "strokeWidth": 3},
      "encoding": {
        "x": {
          "field": "avg_official",
          "type": "quantitative",
          "title": "Cards per set",
          "scale": {"domain": [80, 230]}
        },
        "x2": {"field": "avg_total"}
      }
    },
    {
      "mark": {"type": "circle", "size": 120, "opacity": 1, "color": "#969696"},
      "encoding": {
        "x": {"field": "avg_official", "type": "quantitative"},
        "tooltip": [
          {"field": "era", "title": "Era"},
          {"field": "avg_official", "type": "quantitative", "title": "Numbered cards"},
          {"field": "avg_total", "type": "quantitative", "title": "With secret cards"}
        ]
      }
    },
    {
      "mark": {"type": "circle", "size": 120, "opacity": 1, "color": "#e6550d"},
      "encoding": {
        "x": {"field": "avg_total", "type": "quantitative"},
        "tooltip": [
          {"field": "era", "title": "Era"},
          {"field": "avg_official", "type": "quantitative", "title": "Numbered cards"},
          {"field": "avg_total", "type": "quantitative", "title": "With secret cards"},
          {"field": "secret", "type": "quantitative", "title": "Secret cards"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.secret >= 20"}],
      "mark": {"type": "text", "align": "left", "dx": 10, "fontSize": 11, "color": "#e6550d"},
      "encoding": {
        "x": {"field": "avg_total", "type": "quantitative"},
        "text": {"field": "secret", "type": "quantitative", "format": "+d"}
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}
