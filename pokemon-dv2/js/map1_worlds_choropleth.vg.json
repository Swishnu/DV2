{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": {
      "expr": "Measure_selection == 'players' ? 'Total players at the Pokémon World Championships' : 'Players at the Pokémon World Championships, per million people'"
    },
    "subtitle": "Click a bar to highlight that country on the map.",
    "anchor": "start"
  },
  "params": [
    {
      "name": "Season_selection",
      "value": 2026,
      "bind": {
        "input": "radio",
        "options": [2025, 2026],
        "labels": ["Worlds 2025 (Anaheim)", "Worlds 2026 (San Francisco)"],
        "name": "Championship: "
      }
    },
    {
      "name": "Measure_selection",
      "value": "per_million",
      "bind": {
        "input": "radio",
        "options": ["per_million", "players"],
        "labels": ["Per million people", "Total players"],
        "name": "Show: "
      }
    }
  ],
  "hconcat": [
    {
      "width": 560,
      "height": 330,
      "projection": {"type": "equalEarth"},
      "layer": [
        {
          "data": {
            "url": "js/ne_110m_admin_0_countries.topojson",
            "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
          },
          "transform": [
            {"filter": "datum.properties.ADM0_A3 != 'ATA'"},
            {"calculate": "'No players from ' + datum.properties.NAME", "as": "note"}
          ],
          "mark": {"type": "geoshape", "fill": "#e5e5e5", "stroke": "white", "strokeWidth": 0.5},
          "encoding": {"tooltip": {"field": "note"}}
        },
        {
          "data": {
            "url": "data/worlds_by_country.csv",
            "format": {"parse": {"players": "number", "per_million": "number"}}
          },
          "transform": [
            {"filter": "datum.season == Season_selection"},
            {
              "lookup": "iso3",
              "from": {
                "data": {
                  "url": "js/ne_110m_admin_0_countries.topojson",
                  "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
                },
                "key": "properties.ADM0_A3"
              },
              "as": "geo"
            },
            {"filter": "isValid(datum.geo)"},
            {
              "calculate": "Measure_selection == 'players' ? datum.players : datum.per_million",
              "as": "value"
            }
          ],
          "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
          "encoding": {
            "shape": {"field": "geo", "type": "geojson"},
            "color": {
              "field": "value",
              "type": "quantitative",
              "title": "Darker = more players",
              "scale": {
                "type": "threshold",
                "domain": {
                  "expr": "Measure_selection == 'players' ? [3, 10, 25, 50, 100] : [0.1, 0.25, 0.5, 1, 2]"
                },
                "range": ["#eff3ff", "#c6dbef", "#9ecae1", "#6baed6", "#3182bd", "#08519c"]
              },
              "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 200}
            },
            "tooltip": [
              {"field": "country", "type": "nominal", "title": "Country"},
              {"field": "players", "type": "quantitative", "title": "Players at Worlds"},
              {
                "field": "per_million",
                "type": "quantitative",
                "title": "Per million people",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "data": {
            "url": "data/worlds_by_country.csv",
            "format": {"parse": {"players": "number", "per_million": "number"}}
          },
          "transform": [
            {"filter": "datum.season == Season_selection"},
            {"filter": {"param": "Country_pick", "empty": false}},
            {
              "lookup": "iso3",
              "from": {
                "data": {
                  "url": "js/ne_110m_admin_0_countries.topojson",
                  "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
                },
                "key": "properties.ADM0_A3"
              },
              "as": "geo"
            },
            {"filter": "isValid(datum.geo)"}
          ],
          "mark": {"type": "geoshape", "fill": null, "stroke": "#d62728", "strokeWidth": 2},
          "encoding": {"shape": {"field": "geo", "type": "geojson"}}
        }
      ]
    },
    {
      "width": 200,
      "height": 330,
      "title": {"text": "Top 15 countries", "fontSize": 12},
      "data": {
        "url": "data/worlds_by_country.csv",
        "format": {"parse": {"players": "number", "per_million": "number"}}
      },
      "transform": [
        {"filter": "datum.season == Season_selection"},
        {"filter": "datum.players >= 3"},
        {
          "calculate": "Measure_selection == 'players' ? datum.players : datum.per_million",
          "as": "value"
        },
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "value", "order": "descending"}]
        },
        {"filter": "datum.rank <= 15"},
        {
          "calculate": "Measure_selection == 'players' ? format(datum.value, 'd') : format(datum.value, '.2f')",
          "as": "label"
        }
      ],
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": {"field": "value", "op": "max", "order": "descending"},
          "title": null
        },
        "x": {"field": "value", "type": "quantitative", "title": null, "axis": null}
      },
      "layer": [
        {
          "params": [
            {
              "name": "Country_pick",
              "value": [{"iso3": "AUS"}],
              "select": {"type": "point", "fields": ["iso3"]}
            }
          ],
          "mark": {"type": "bar", "cursor": "pointer"},
          "encoding": {
            "color": {
              "condition": {"param": "Country_pick", "value": "#d62728", "empty": false},
              "value": "#6baed6"
            },
            "tooltip": [
              {"field": "country", "type": "nominal", "title": "Country"},
              {"field": "players", "type": "quantitative", "title": "Players at Worlds"},
              {
                "field": "per_million",
                "type": "quantitative",
                "title": "Per million people",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "mark": {"type": "text", "align": "left", "dx": 3, "fontSize": 10},
          "encoding": {"text": {"field": "label"}}
        }
      ]
    }
  ],
  "config": {"view": {"stroke": null}}
}
